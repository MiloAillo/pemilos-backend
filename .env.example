# Environment Configuration Example
# Copy this file to .env.dev for development or .env.prod for production
# and fill in the appropriate values

# Server Configuration
APP_PORT=8000
APP_PORT_EXTERNAL=5000
NODE_ENV=development

# JWT Secret (REQUIRED - min 32 characters)
# Generate with: openssl rand -base64 32
JWT_KEY=your-jwt-key-min-32-characters-long

# CORS: Comma-separated list of allowed origins
# Development: http://localhost:5174
# Production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5174

# Cloudflare Proxy Settings
# REQUIRED in production: Set to 'true' when deployed behind Cloudflare
# - Enables CF-Connecting-IP header for accurate client IP detection
# - Used by rate limiter to identify unique users
# - Cloudflare strips fake CF-Connecting-IP headers (cannot be spoofed)
#
# SECURITY WARNING: Only set 'true' if actually behind Cloudflare/proxy
# Setting incorrectly allows attackers to bypass rate limits
# - Development (direct access): Leave empty or set 'false'
# - Production (via Cloudflare): Set 'true'
TRUST_PROXY=

# Rate Limiting
WINDOW_SIZE_IN_SECONDS=60
MAX_REQUESTS=100

# Redis Configuration
# PRODUCTION SECURITY: Use ACL-based authentication (see redis.conf)
# - REDIS_USERNAME: Set to 'appuser' for production (restricted permissions)
# - REDIS_PASSWORD: Generate with: openssl rand -base64 32
# DEVELOPMENT: Can use password-only auth (leave REDIS_USERNAME empty)
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_HOST=redis

# MongoDB Configuration
MONGODB_ROOT_USER=admin
MONGODB_ROOT_PASSWORD=your-mongodb-password
MONGODB_HOST=mongo_db
MONGODB_PORT=27017
MONGODB_DATABASE=pemilom

# Pusher Configuration
PUSHER_APPID=your-pusher-app-id
PUSHER_KEY=your-pusher-key
PUSHER_SECRET=your-pusher-secret
PUSHER_CLUSTER=ap1

# Monitoring (for Prometheus/Grafana)
NODE_EXPORTER_PORT=9100
NODE_EXPORTER_HOST=node_exporter

# Server will NOT start if required env vars are missing:
#    - APP_PORT, JWT_KEY (32+ chars)
#    - MONGODB_ROOT_USER, MONGODB_ROOT_PASSWORD
