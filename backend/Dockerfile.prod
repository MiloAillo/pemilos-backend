FROM node:alpine AS builder

WORKDIR /build

COPY ./backend/package*.json ./

RUN npm ci

COPY ./backend ./

RUN npm run build && npm prune --omit=dev

FROM node:alpine

WORKDIR /app

COPY --from=builder ./build/package*.json ./
COPY --from=builder ./build/dist ./dist
COPY --from=builder ./build/node_modules ./node_modules

RUN mkdir -p /app/uploads && chown -R node:node /app/uploads && chmod -R 755 /app/uploads
RUN mkdir -p /app/logs && chown -R node:node /app/logs && chmod -R 755 /app/logs

# Security: Remove unnecessary packages
RUN apk --no-cache del apk-tools

USER node

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD node -e "require('http').get('http://localhost:8000/health', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})" || exit 1

EXPOSE 8000

CMD ["npm", "run", "start"]
