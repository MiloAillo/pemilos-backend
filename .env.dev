# Server port (default: 3000)
APP_PORT=8000

# Environment mode:
# - development: Detailed error messages, verbose logging
# - production: Sanitized errors, minimal logging
NODE_ENV=development

# JWT Secret Key (REQUIRED - min 32 characters for security)
# Generate with: openssl rand -base64 32
# Example: aB3dEf7gHi9jKl2mNo5pQr8sTu1vWx4yZ6
JWT_KEY=dev-jwt-key-min-32-characters-long-for-development-only

# CORS: Comma-separated list of allowed origins
# Development: http://localhost:5174
# Production: https://yourdomain.com,https://www.yourdomain.com
ALLOWED_ORIGINS=http://localhost:5174

# Cloudflare Proxy Settings
# Set to 'true' if behind Cloudflare CDN (production)
# Trusts CF-Connecting-IP header for rate limiting
TRUST_PROXY=false

# Sliding window size in seconds (default: 60)
WINDOW_SIZE_IN_SECONDS=60

# Maximum requests per window (default: 100)
# Development: 100+ for testing
# Production: 50-100 for normal traffic
MAX_REQUESTS=100

# Redis authentication (optional for local development)
REDIS_USERNAME=

# Redis password (recommended for production)
REDIS_PASSWORD=

# Redis port (default: 6379)
REDIS_PORT=6379

# Redis host
# Docker: redis
# Local: localhost or 127.0.0.1
REDIS_HOST=redis

# MongoDB admin username (required)
MONGODB_ROOT_USER=admin

# MongoDB admin password (required - use strong password in production)
MONGODB_ROOT_PASSWORD=dev-mongodb-password-change-in-production

# Database name
MONGODB_DATABASE=pemilom

# MongoDB host
# Docker: mongo_db (service name from docker-compose.yml)
# Local: localhost or 127.0.0.1
MONGODB_HOST=mongo_db

# MongoDB port (default: 27017)
MONGODB_PORT=27017

# Pusher App ID (get from https://dashboard.pusher.com)
PUSHER_APPID=dev-pusher-app-id

# Pusher Key
PUSHER_KEY=dev-pusher-key

# Pusher Secret
PUSHER_SECRET=dev-pusher-secret

# Pusher Cluster (e.g., ap1, eu, us2)
PUSHER_CLUSTER=ap1

# Node Exporter for Prometheus metrics
NODE_EXPORTER_PORT=9100
NODE_EXPORTER_HOST=node_exporter

# These should be set in frontend/.env, not here

# VITE_API_URL=http://localhost:3000
# VITE_PUSHER_APPID=
# VITE_PUSHER_KEY=
# VITE_PUSHER_SECRET=
# VITE_PUSHER_CLUSTER=

# Server will NOT start if required env vars are missing:
#    - APP_PORT, JWT_KEY (32+ chars)
#    - MONGODB_ROOT_USER, MONGODB_ROOT_PASSWORD
#    - MONGODB_DATABASE, MONGODB_HOST, MONGODB_PORT
#    - REDIS_HOST, REDIS_PORT
